@page
@model Tp_2_C_ASP.NET.Pages.CityManager.CreateCityModel
@{
    ViewData["Title"] = "Validação Client-Side";
}

<h2>Cadastro de Cidade (Validação Client-Side)</h2>

<form method="post">
    <div>
        <label asp-for="Input.CityName">Nome da Cidade:</label>
        <input type="text" asp-for="Input.CityName" />
        <span asp-validation-for="Input.CityName" style="color: red;"></span>
    </div>

    <button type="submit">Salvar</button>
</form>

@if (!string.IsNullOrEmpty(Model.SubmittedCityName))
{
    <p style="color: green;">Cidade validada e cadastrada: <strong>@Model.SubmittedCityName</strong></p>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}