@page
@model Tp_2_C_ASP.NET.Pages.CityManager.CriarPaisModel
@{
    ViewData["Title"] = "Cadastrar País com Validação Customizada";
}

<h2>Cadastro de País (Validação Customizada)</h2>

<form method="post">
    <div>
        <label asp-for="Input.CountryName">Nome do País:</label>
        <input type="text" asp-for="Input.CountryName" />
        <span asp-validation-for="Input.CountryName" style="color: red;"></span>
    </div>

    <div>
        <label asp-for="Input.CountryCode">Código do País (Ex: BR):</label>
        <input type="text" asp-for="Input.CountryCode" />
        <span asp-validation-for="Input.CountryCode" style="color: red;"></span>
    </div>

    <button type="submit" style="margin-top: 10px;">Cadastrar País</button>
</form>

@if (Model.CreatedCountry != null)
{
    <div style="margin-top: 20px; color: green;">
        <p>País cadastrado com sucesso!</p>
        <p><strong>Nome:</strong> @Model.CreatedCountry.CountryName</p>
        <p><strong>Código:</strong> @Model.CreatedCountry.CountryCode</p>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}